venv/
env/
ENV/
.venv/
env.bak/
venv.bak/



/media/
# collectstatic komutunun derlediği statik dosya çıktısı
/staticfiles/

# SQLite kullanılması durumunda veritabanı dosyasının git'e girmemesi için
*.sqlite3
*.sqlite3-journal
*.db

# Celery Beat zamanlayıcısının çalışma esnasında ürettiği geçici takip dosyaları
celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid


*.log
logs/
*.pid

